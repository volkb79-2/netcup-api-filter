# Basic-auth inputs for human access through the local Traefik guard.
# Copy to .env.guard (gitignored), fill the credentials, then load before ciu:
#   set -a; . ./.env.guard; set +a
# The real .env.guard is gitignored. Do not use this guard for browser-test credentials.
NAF_GUARD_USER="<guard-user>"
NAF_GUARD_PASSWORD=
NAF_GUARD_HTPASSWD=
