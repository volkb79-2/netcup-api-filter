# Inputs for explicitly requested live-tier checks (email, DNS and provider config).
# Copy to .env.live (gitignored), keep and fill only the lines used for that run, then load:
# (delete the others: sourcing exports every line, so an empty or placeholder value would
# replace a reader's built-in default)
#   set -a; . ./.env.live; set +a
# The real .env.live is gitignored. SMTP is configured in the app's Settings UI/DB;
# POWERDNS_API_URL values come from .env.services and its API key from CIU.
DEPLOYMENT_MODE="<deployment-mode>"

# Live DNS lifecycle checks (ui_tests/tests/live/test_live_dns_verification.py)
DNS_TEST_DOMAIN="<dns-test-domain>"
DNS_TEST_SUBDOMAIN_PREFIX="<subdomain-prefix>"
DNS_PROPAGATION_TIMEOUT="<timeout-seconds>"
DNS_PROPAGATION_POLL_INTERVAL="<poll-interval-seconds>"
DNS_CHECK_SERVERS="<resolver-ip-1>,<resolver-ip-2>"

# Live mailbox polling (ui_tests/tests/live/test_live_email_verification.py)
IMAP_HOST="<imap-host>"
IMAP_PORT="<imap-port>"
IMAP_USER="<mailbox-user>"
IMAP_PASSWORD=
IMAP_USE_TLS="<true-or-false>"
IMAP_MAILBOX="<mailbox>"
IMAP_MAILBOXES="<mailbox-list-or-empty>"
IMAP_TIMEOUT="<timeout-seconds>"
IMAP_MESSAGE_LOOKBACK="<message-count>"

# Optional runtime inputs read by the app's Netcup and GeoIP integrations.
NETCUP_CUSTOMER_ID="<netcup-customer-id>"
NETCUP_API_KEY=
NETCUP_API_PASSWORD=
MAXMIND_ACCOUNT_ID="<maxmind-account-id>"
MAXMIND_LICENSE_KEY=
MAXMIND_API_URL=
