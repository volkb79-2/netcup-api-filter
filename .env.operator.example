# Local stack facts supplied by the operator (for example, the delegated DNS zone).
# Copy to .env.operator (gitignored), fill the value, then load before ciu:
#   set -a; . ./.env.operator; set +a
# The real .env.operator is gitignored. PUBLIC_FQDN and PUBLIC_IP come from
# generated .env.workspace; the PowerDNS API key is generated by CIU.
NAF_DELEGATED_DNS_ZONE="<delegated-zone>"
