# ============================================================================
# Service URLs derived from CIU-resolved identities
# ============================================================================
# Prerequisites, in this order (`ciu resolve` renders the global config, which
# needs them): `eval "$(ciu env print)"`, `export PWMCP_NETWORK=...`, the guard
# environment (`.env.guard`), then source this file. It asks `ciu resolve` for
# the exact container identities of this checkout; it never builds a name from
# PROJECT_TAG/ENV_TAG. It resolves against the `full` profile (every naf stack),
# not this checkout's selected profiles, so a narrow selection cannot hide a
# peer. An identity ciu does not report is warned about and its variables are
# unset; the consumer that needs one fails on it (build_deployment.py, `${VAR:?}`).
#
# For an offline unit fixture, set NAF_CIU_RESOLVE_JSON to a document produced by
# `ciu resolve --json`. NAF_CIU_GLOBAL_CONFIG may point at a fixture copy of the
# rendered ciu.global.toml when only the public PowerDNS URL is under test.
# ============================================================================

if [ -n "${NAF_CIU_RESOLVE_JSON:-}" ]; then
    _naf_resolve_json="$NAF_CIU_RESOLVE_JSON"
else
    _naf_resolve_json="$(ciu resolve --json --profile full)" || {
        echo "[ERROR] .env.services: ciu resolve --json --profile full failed" >&2
        return 1
    }
fi
if [ -z "$_naf_resolve_json" ]; then
    echo "[ERROR] .env.services: empty ciu resolve document" >&2
    return 1
fi

_naf_services_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_naf_assignments="$(
    printf '%s\n' "$_naf_resolve_json" |
        python3 "$_naf_services_root/tooling/ciu_resolve_env.py" \
            --global-config "${NAF_CIU_GLOBAL_CONFIG:-$_naf_services_root/ciu.global.toml}"
)" || {
    echo "[ERROR] .env.services: could not derive service identities" >&2
    return 1
}
eval "$_naf_assignments" || {
    echo "[ERROR] .env.services: invalid generated shell assignments" >&2
    return 1
}

unset _naf_resolve_json _naf_services_root _naf_assignments
