# Human webhoster URL and SSHFS route; not read by the ciu host inventory.
# Copy to .env.webhoster (gitignored), fill the values, then load in your shell:
#   set -a; . ./.env.webhoster; set +a
# The real .env.webhoster is gitignored. Do not put provider credentials here.
WEBHOSTING_URL="<webhoster-url>"
WEBHOSTING_SSH_USER="<ssh-user>"
WEBHOSTING_SSH_HOST="<ssh-host>"
WEBHOSTING_REMOTE_DIR="<remote-directory>"
