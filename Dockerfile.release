# Dockerfile.release — netcup-api-filter self-hosting container image (py311 and py314 bake targets).
# =============================================================================
# Phase 1 of naf's cmru adoption (nyxloom-trove/CMRU-RELEASE-PLAN-2026-07-21.md):
# the container release target. Built via docker-bake.hcl's "release" group (py311, py314) —
#   ciu (local dev/inspect): docker buildx bake -f docker-bake.hcl release --load
#   cmru (publish to ghcr):  docker buildx bake -f docker-bake.hcl release --push
#
# Runs the REAL app, mirroring tooling/app-local/ciu.compose.yml.j2's entrypoint
# exactly: gunicorn -c gunicorn.conf.py passenger_wsgi:application, port 5100,
# health GET /admin/login. This is NOT the retired root Dockerfile it replaces
# (that one installed a non-existent requirements.txt, a YAML config, and ran
# the dead filter_proxy module — deleted, B-OPS).
#
# Layout mirrors build_deployment.py's copy_application_files(): passenger_wsgi.py
# is copied from its canonical location (src/netcup_api_filter/passenger_wsgi.py)
# to the deploy root, alongside the full src/ tree and gunicorn.conf.py — the same
# arrangement Passenger webhosting and the app-local dev stack both use, so
# passenger_wsgi.py's own app_root/src_root resolution (Path(__file__).resolve())
# works unmodified in the container.
#
# The image ships NO accounts, NO .env.defaults and NO secrets. It ships app-defaults.env
# (the runtime-only defaults catalog, generated below). State lives in the /data volume:
# NETCUP_FILTER_DB_PATH=/data/netcup_filter.db. The first boot creates that database through
# the app's normal init_db path, which FAILS FAST (gunicorn exits non-zero: "Worker failed to boot") unless the operator supplies the first admin
# (NAF_BOOTSTRAP_ADMIN_USERNAME, NAF_BOOTSTRAP_ADMIN_EMAIL and NAF_BOOTSTRAP_ADMIN_PASSWORD_FILE,
# or an app-config.toml admin). SECRET_KEY comes from SECRET_KEY_FILE / SECRET_KEY, else the
# app persists a generated one in the database. Netcup credentials (NETCUP_CUSTOMER_ID/
# NETCUP_API_KEY/NETCUP_API_PASSWORD) are supplied by the operator as well. See
# docs/DEPLOYMENT_WORKFLOW.md.
# =============================================================================

ARG PYTHON_VERSION
FROM python:${PYTHON_VERSION}-slim-trixie

WORKDIR /app

# Runtime closure only — the same requirements file the Passenger webhosting
# deploy installs (requirements-test.txt is test/gate-only and never ships).
# gunicorn itself is NOT in requirements-runtime.txt (Passenger hosts don't
# need it — Passenger is its own process manager); this image is its own
# webserver, so it is installed explicitly, pinned like requirements-test.txt.
COPY requirements-runtime.txt ./
RUN pip install --no-cache-dir -r requirements-runtime.txt "gunicorn>=21.0.0"

# Canonical application code + the two deploy-root files passenger_wsgi.py
# expects beside it, exactly as build_deployment.py's copy_application_files()
# lays out a Passenger deployment directory.
COPY src/ ./src/
COPY src/netcup_api_filter/passenger_wsgi.py ./passenger_wsgi.py
COPY gunicorn.conf.py ./gunicorn.conf.py

# app-defaults.env = the allowlisted runtime keys of .env.defaults (never the pre-set admin
# password or any credential), rendered by the same function the Passenger tarball and deploy-local builds use.
# .env.defaults is only bind-mounted for this one step: it is never copied into a layer.
RUN --mount=type=bind,source=.env.defaults,target=/tmp/build-env.defaults \
    PYTHONPATH=/app/src python -c "from pathlib import Path; from netcup_api_filter.config_defaults import write_shipped_defaults; print(write_shipped_defaults(Path('/tmp/build-env.defaults'), Path('/app')))"

ENV PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    NETCUP_FILTER_DB_PATH=/data/netcup_filter.db

# The database (and the persisted SECRET_KEY row) live here, not in the image layer.
VOLUME /data

# gunicorn.conf.py's GUNICORN_BIND default (0.0.0.0:5100) — keep in sync with
# tooling/app-local/ciu.defaults.toml.j2's app_local.port.
EXPOSE 5100

HEALTHCHECK --interval=10s --timeout=5s --start-period=60s --retries=6 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:5100/admin/login', timeout=3).status==200 else 1)"

CMD ["gunicorn", "-c", "gunicorn.conf.py", "passenger_wsgi:application"]
