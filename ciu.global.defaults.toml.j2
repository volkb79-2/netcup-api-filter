# ciu.global.defaults.toml.j2 — REPO-ROOT MARKER (naf)
# =============================================================================
# This file's EXISTENCE is how ciu locates REPO_ROOT (walk-up, SPEC S1.1).
#   Rendered output: ciu.global.toml  (GITIGNORED — never edit the rendered file)
#   Sparse override:  ciu.global.toml.j2 (optional, not committed by default)
#   Machine facts:    ciu.env (from `ciu env generate` — authoritative, gitignored)
#
# Doctrine (see nyxloom-trove/INFRA-PLAN-2026-07-20.md): the devcontainer is a
# COCKPIT, not a ship signal. Builds and the gating suite run in version-specific
# containers matching the shipped runtimes (3.11 Passenger, 3.14 OCI image).
# =============================================================================

[ciu]
# SPEC S1.2 — naf is a STANDALONE ROOT. ciu MUST refuse to run when $REPO_ROOT points
# somewhere else, instead of silently operating on that other repo.
#
# WHY THIS IS LOAD-BEARING HERE: this devcontainer's ~/.bashrc auto-sources
# "${REPO_ROOT}/ciu.env", and dstdns is the devcontainer's primary workspace — so every
# login shell starts with REPO_ROOT=/workspaces/dstdns. S1.1 resolves
# --define-root -> $REPO_ROOT -> cwd walk-up, so that stale env BEAT naf's marker and a
# bare `ciu render` from this repo rendered 17 DSTDNS stacks.
#
# WHAT THIS ACTUALLY BUYS (measured, not assumed):
#   * `ciu up`    — PROTECTED. Fails with "[S1.2] ... Expected: /workspaces/netcup-api-filter,
#                   got: /workspaces/dstdns". This is the MUTATING path (it creates
#                   containers), so the dangerous case is covered.
#   * `ciu render` — NOT protected. Upstream bug: deploy.py:1633 calls
#                   detect_standalone_root(repo_root) on the ALREADY-RESOLVED root, so it
#                   finds dstdns's marker (no standalone_root) and passes. engine.py:1033
#                   correctly walks from working_dir. The guard therefore misses the very
#                   cross-repo case it was written for. Worth reporting upstream.
#
# So the reliable workflow is still `source ciu.env` (it exports the correct REPO_ROOT) —
# NOT sprinkling --define-root on every invocation. standalone_root is the safety net.
standalone_root = true
repo_root = "$REPO_ROOT"
physical_repo_root = "$PHYSICAL_REPO_ROOT"
workspace_env_file = "ciu.env"
# naf's dev edge is being moved to the host traefik (naf-I04); until that lands
# nothing here requires certs or a resolvable FQDN.
require_certs = false
require_fqdn = false
fail_fast = true
auto_connect_network = true

# =============================================================================
# Build — the shipped runtimes. SINGLE SOURCE for the gate images and CMRU's
# Passenger-variant builder.
#   3.11 = Passenger target (CMRU variant py311)
#   3.14 = OCI self-hosting image (docker-bake.hcl / cmru.toml), gated like 3.11.
# =============================================================================
[build]
python_version_primary = "3.11"
python_version_secondary = "3.14"
# Exact age-windowed patch tags from versions/oci-images.json (cmru targets
# oci.python311 / oci.python314). The mocks use the primary image so they follow
# the Passenger/runner policy.
python_base_image = "python:3.11.17-slim-trixie"
python_base_image_secondary = "python:3.14.9-slim-trixie"

[deploy]
# naf's container convention is <project>-<env>-<svc> => naf-dev-test-runner,
# matching DOCKER_NETWORK_INTERNAL="naf-dev-network" in .env.workspace.
project_name = "naf"
environment_tag = "dev"
# The ciu-derived name (<repo>-<path-hash>-network) is authoritative now. This is safe
# to reference again ONLY because standalone_root above guarantees $REPO_ROOT is naf's —
# without it, a dstdns-contaminated shell would resolve this to dstdns's network.
# Known trade-off: the hash embeds the checkout path, so moving the repo renames the
# network (recorded in backlog B-INFRA).
network_name = "$DOCKER_NETWORK_INTERNAL"
log_level = "INFO"

[deploy.registry]
# Local-only images; nothing is pushed from this repo.
url = ""
namespace = "netcup-api-filter"

[deploy.labels]
prefix = "de.vxxu.volkb79"

[deploy.health]
interval = "10s"
timeout = "5s"
retries = 6
start_period = "60s"

[deploy.env.defaults]
TZ = "UTC"
PYTHONUNBUFFERED = "1"

# Machine-identity facts exposed to compose templates + hostdir ownership.
# ciu.env is the source; naf's own scripts read the equivalent USER_UID/DOCKER_GID
# from .env.workspace (same values, older names).
[deploy.env.shared]
CONTAINER_UID = "$CONTAINER_UID"
CONTAINER_GID = "$DOCKER_GID"
DOCKER_GID = "$DOCKER_GID"
USER_UID = "$CONTAINER_UID"
REPO_ROOT = "$REPO_ROOT"
PHYSICAL_REPO_ROOT = "$PHYSICAL_REPO_ROOT"

# =============================================================================
# Governance (SPEC S15) — the cgroup/mem/IO safeguards.
# ciu injects these as standard compose keys into .ciu/ciu.compose.overlay.yml;
# the kernel + systemd slice do the enforcing. Author-set keys always win.
#
# `device` is set EXPLICITLY: autodetect (findmnt on /var/lib/docker) does not
# work from inside a DooD devcontainer. /dev/vda backs docker on this host.
# `ksm_optin` points at the vendored shim (tooling/ksm-optin/); ciu injects
# LD_PRELOAD + a bind of it into every non-exempt service so identical pages
# across naf's long-lived containers (mocks, PowerDNS, app) dedupe via KSM.
# =============================================================================
[governance]
enabled = true
cgroup_parent = "besteffort.slice"
mem_limit = "2g"
mem_reservation = "256m"
read_iops = 200
write_iops = 400
device = "/dev/vda"
ksm_optin = "tooling/ksm-optin/ksm-optin.so"
exempt_services = []

# =============================================================================
# Stack registry — a stack is only rendered/brought up if it is declared here.
# naf is deliberately small: the gating test-runner, and (naf-I02) the pwmcp
# browser service the e2e gate connects to. Order matters: pwmcp must be up
# before the e2e gate can reach ws://pwmcp:3000/.
# =============================================================================
# phase_0 — backing services the app and the suite talk to. These come up first.
[deploy.phases.phase_0]
name = "Backing services"
description = "Mocks, mail sink, DNS backend and the browser service"
enabled = true

[[deploy.phases.phase_0.services]]
path = "tooling/mailpit"

[[deploy.phases.phase_0.services]]
path = "tooling/geoip-mock"

[[deploy.phases.phase_0.services]]
path = "tooling/netcup-api-mock"

# backend-powerdns: reworked to source its zone from [topology.dns].delegated_zone
# (D-007) instead of invented SOA defaults; the zone-create hook needs a live `ciu up`
# to validate the pdnsutil argument shapes.
[[deploy.phases.phase_0.services]]
path = "tooling/backend-powerdns"

# phase_1 — the app itself, then the gating peer. The app is a CONTAINER now (naf-I04):
# it used to be a host gunicorn process in the devcontainer, which traefik's docker
# provider could not discover because there were no container labels to read.
[deploy.phases.phase_1]
name = "Application and gate"
description = "The containerized dev app + the gating test-runner peer"
enabled = true

[[deploy.phases.phase_1.services]]
path = "tooling/app-local"

[[deploy.phases.phase_1.services]]
path = "tooling/test-runner"

[deploy.profiles.test]
stacks = ["tooling/test-runner"]

[deploy.profiles.mocks]
stacks = ["tooling/mailpit", "tooling/geoip-mock", "tooling/netcup-api-mock", "tooling/backend-powerdns"]

[deploy.profiles.full]
stacks = [
    "tooling/mailpit",
    "tooling/geoip-mock",
    "tooling/netcup-api-mock",
    "tooling/backend-powerdns",
    "tooling/app-local",
    "tooling/test-runner",
]

# =============================================================================
# Topology — declarative facts consumed by compose templates.
# public_fqdn is INTENTIONALLY EMPTY until naf-I04 (host-traefik exposure) is
# reviewed: the FQDN becomes a config fact here, replacing the reverse-DNS
# detection in docs/FQDN_DETECTION.md. Do NOT guess a hostname.
# =============================================================================
[topology.external]
# NEVER hardcode the FQDN. ciu.env already detects PUBLIC_FQDN (reverse DNS of PUBLIC_IP),
# so exposed stacks template their Host() rule from topology.external.public_fqdn:
#     app            -> naf.<public_fqdn>
#     PowerDNS edge  -> naf-pdns.<public_fqdn>
# (Written without Jinja braces on purpose: '#' is NOT a Jinja comment, so a real
# expression here would be evaluated while rendering THIS file and blow up.)
# A wildcard record on that base points every <name>.<fqdn> at this host, and traefik's
# letsencrypt resolver issues the cert on the `websecure` entrypoint — so consumers need
# NO tls/certresolver labels of their own.
public_fqdn = "$PUBLIC_FQDN"
tls = true

# The shared ingress network owned by the host-side tls-edge stack (edge-traefik).
# Exposed containers join this IN ADDITION to the project network; backends stay
# project-internal. naf terminates no TLS and holds no certs (naf-I04).
ingress_network = "ingress_public"

# [topology.pwmcp] — the Playwright service is NOT ours: the estate runs one pwmcp instance
# (/srv/pwmcp-instance) and naf is a consumer. The browser lives in that container, so the
# app (browser target) and the test runners (clients) must share a network with it. The
# network name is a host fact: export PWMCP_NETWORK=<network_name from
# /srv/pwmcp-instance/ciu.global.toml>. Unset => ciu refuses to render (no default, on purpose).
[topology.pwmcp]
network = "$PWMCP_NETWORK"

# ---------------------------------------------------------------------------
# [topology.dns] — the delegated DNS zone that makes up naf's dev/test DNS infra.
# CROSS-STACK by design (D-007): read by BOTH the backend-powerdns stack (which must
# be authoritative for the zone) AND the app stack (which seeds a domain-root/backend
# so a user owns the zone and can create hosts under it). Modeled on
# topology.external.public_fqdn — a global topology fact, not a single stack's config.
#
# Operator-specific infra, NOT shipped data: the operator delegates a real (sub)domain
# whose NS points at this host's PUBLIC_IP, then sets NAF_DELEGATED_DNS_ZONE in the
# environment (ciu.env / an .env). The committed default is EMPTY — for a released
# product this is the placeholder a sysadmin fills in. `env.get(... ) or ''` (not a bare
# "$VAR") so render does NOT hard-fail when it is unset; consumers guard on non-empty.
[topology.dns]
delegated_zone = "{{ env.get('NAF_DELEGATED_DNS_ZONE') or '' }}"
# The public FQDN the PowerDNS API is reached at through traefik (naf-pdns.<fqdn>).
pdns_subdomain = "naf-pdns"

# ---------------------------------------------------------------------------
# basicauth guard (operator decision 2026-07-20): the product is NOT production
# ready and must not be publicly reachable, so EVERY exposed route sits behind a
# traefik basicauth middleware. The guard is for HUMANS only: the e2e suite targets
# the app over the internal docker network and never goes through traefik, so test
# code carries no guard credentials.
#
# guard_htpasswd is a bcrypt hash sourced from the environment — NEVER committed.
# It lives with the plaintext in the gitignored .env.guard (see that file's header
# for regeneration).
# ---------------------------------------------------------------------------
#
# NOTE the hash is deliberately NOT a key here. A bcrypt hash starts with "$2b$", and
# ciu's env-placeholder pass reads that as an unresolved "$2b" placeholder and aborts.
# So compose templates emit ${NAF_GUARD_HTPASSWD} and let DOCKER COMPOSE interpolate it
# at up-time — which also keeps the hash out of every rendered artifact.
[topology.guard]
enabled = true
user = "$NAF_GUARD_USER"
