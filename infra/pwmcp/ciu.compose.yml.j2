# infra/pwmcp/ciu.compose.yml.j2 — PWMCP: Playwright-as-a-Service for naf's e2e gate
# =============================================================================
#   Rendered output: ciu.compose.yml  (GITIGNORED)
#   Governance overlay: .ciu/ciu.compose.overlay.yml (generated by ciu from
#   [governance] in ciu.global.toml — cgroup_parent / mem_limit / blkio IOPS)
#
# WHY: the gate image (tooling/test-runner/Dockerfile) ships NO browser engine by
# design. JS-rendered UI tests connect to THIS container over ws://pwmcp:3000/
# (PLAYWRIGHT_SERVER_WS). This is the netcup equivalent of dstdns infra/pwmcp.
#
# The image is the shared, prebuilt, digest-tracked unified Playwright image
# (Playwright run-server :3000 + @playwright/mcp :8931 under supervisord). naf uses
# ONLY the :3000 connect() path; the raw `chromium.connect("ws://pwmcp:3000/")`
# path needs no lease headers (the gateway falls back to the default lease).
#
# COMPOSE PROJECT NAME (was load-bearing, now ciu's job): the old hand-written
# compose pinned an explicit `name: naf-pwmcp` because dstdns's `infra/pwmcp/` also
# defaults to compose project `pwmcp` (directory basename) — a bare `docker compose
# up` from here once adopted, then recreated-and-removed, dstdns's shared
# `pwmcp-local-pwmcp` (hit live, see nyxloom-trove/backlog.md B-INFRA). ciu drives
# `docker compose` with an explicit project scope derived from deploy.project_name
# ("{{ deploy.project_name }}"), not the directory basename, so that footgun no
# longer applies here — do NOT reintroduce a bare `docker compose -f ... up`
# workflow against this file.
#
# Hardened on purpose: non-root user, all caps dropped, no-new-privileges, and a
# real /dev/shm (Chromium crashes on the 64mb compose default). Do not weaken these.
# =============================================================================

services:
  {{ pwmcp.name }}:
    image: {{ pwmcp.image_registry }}/{{ pwmcp.image_name }}:{{ pwmcp.image_tag }}
    pull_policy: {{ pwmcp.pull_policy }}
    container_name: {{ deploy.project_name }}-{{ deploy.environment_tag }}-{{ pwmcp.name }}
    # supervisord is the ENTRYPOINT — no command override.
    user: "1000:1000"
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    shm_size: "{{ pwmcp.shm_size }}"
    restart: unless-stopped
    environment:
      # Only the :3000 WS path is used by naf; these keep the image's defaults explicit.
      PWMCP_MCP_ALLOWED_HOSTS: "{{ pwmcp.name }}:{{ pwmcp.ports.mcp }},{{ deploy.project_name }}-{{ deploy.environment_tag }}-{{ pwmcp.name }}:{{ pwmcp.ports.mcp }}"
      PWMCP_RUN_SERVER_PORT: "{{ pwmcp.ports.run_server }}"
      PWMCP_RUN_SERVER_UPSTREAM_PORT: "{{ pwmcp.ports.run_server_upstream }}"
      PWMCP_RUN_SERVER_ADMIN_PORT: "{{ pwmcp.ports.run_server_admin }}"
      PWMCP_RUN_SERVER_DEFAULT_LEASE_S: "{{ pwmcp.tunables.default_lease_s }}"
      PWMCP_RUN_SERVER_MAX_LEASE_S: "{{ pwmcp.tunables.max_lease_s }}"
      PWMCP_RUN_SERVER_MAX_CLIENTS: "{{ pwmcp.tunables.max_clients }}"
      PWMCP_RUN_SERVER_IDLE_RECYCLE_S: "{{ pwmcp.tunables.idle_recycle_s }}"
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:{{ pwmcp.ports.run_server }}/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      {{ deploy.network_name }}:
        aliases:
          - {{ pwmcp.name }}
    labels:
      - "{{ deploy.labels.prefix }}.component={{ pwmcp.name }}"
      - "{{ deploy.labels.prefix }}.stack=infra"
      - "{{ deploy.labels.prefix }}.service-type=browser"
      - "{{ deploy.labels.prefix }}.managed-by=ciu"

networks:
  {{ deploy.network_name }}:
    external: true
    name: {{ deploy.network_name }}
