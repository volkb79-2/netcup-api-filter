# tooling/app-local/ciu.defaults.toml.j2 — STACK MARKER (containerized dev app)
# =============================================================================
#   Rendered output: ciu.toml  (GITIGNORED)
#
# WHY THIS STACK EXISTS (naf-I04): the dev app used to run as a HOST gunicorn process
# inside the devcontainer (the retired local runner used `gunicorn -c gunicorn.conf.py passenger_wsgi:application`,
# `pkill -9 gunicorn`). traefik's docker provider builds routes from CONTAINER LABELS, so a
# host process is invisible to it — there is nothing to label. Containerizing the app makes
# it label-discoverable, and simultaneously removes one more "the devcontainer is the
# runtime" dependency, which is the whole point of this infra track.
#
# IMAGE REUSE: this deliberately runs the test-runner py311 image rather than building a
# second app image. That image already carries the runtime closure at the PRIMARY Passenger
# ABI (3.11) plus gunicorn, so the dev app executes against the same interpreter+closure the
# gate proves — one image, one fidelity story. Production is unaffected: it ships to shared
# webhosting under Passenger, not from this container.
#
# PREREQUISITE: `run-gate local-build` must have produced `deploy-local/` (via
# `build_deployment.py --local`, then unzip). This stack
# serves that directory over the mounted repo; it does not build the app itself.
# =============================================================================

[app_local]
name = "app"
# Same image the gate uses — see IMAGE REUSE above.
image_name = "test-runner"
image_tag = "py311"

# The port gunicorn binds inside the container. gunicorn.conf.py defaults GUNICORN_BIND to
# 0.0.0.0:5100; keep these two in sync or the traefik service port points at nothing.
port = 5100

# Session cookie `Secure` flag for THIS long-lived instance. Humans reach it over HTTPS through traefik,
# so it is true. (The e2e gate no longer uses this stack: it starts its own throwaway instance inside the
# test runner, which states FLASK_SESSION_COOKIE_SECURE=false for its plain-HTTP origin.) Never implicit.
cookie_secure = "true"

# Interpreter + import path for the one-shot `python -m netcup_api_filter.bootstrap init` that the
# post_compose hook runs INSIDE this container (same order passenger_wsgi.py uses: vendor/ before src/).
init_python = "/opt/tester-venv/bin/python"
init_pythonpath = "vendor:src"

# Directory (relative to the repo root) that the local test workflow unpacks the build into.
deploy_dir = "deploy-local"

# The administrator of THIS instance. Its password is a ciu-generated secret (see [app_local.secrets]):
# no default password exists anywhere; `ciu up` prints the store-file path, never the value.
[app_local.bootstrap_admin]
username = "admin"
email = "admin@example.com"

# Outgoing mail of this LOCAL instance goes to the mailpit stack (no auth, no TLS).
[app_local.mail]
from_email = "naf@example.com"
admin_email = "admin@example.com"

# Per-instance secrets, generated once into the project store (.ciu/secrets/, gitignored) and mounted
# at /run/secrets/<name> (S4.17 *_FILE convention). The SECRET_KEY arriving from outside the database
# also removes any multi-worker first-start race at the source.
[app_local.secrets]
secret_key = "GEN_LOCAL:naf/app_local_secret_key"
bootstrap_admin_password = "GEN_LOCAL:naf/app_local_bootstrap_admin_password"

# The instance's own data directory (its SQLite DB lives here, not in the build tree): deploy-local/
# netcup_filter.db stays the pristine golden DB that the e2e gate copies per session.
[app_local.app.hostdir]
data = ""

[app_local.external]
# Exposed through the host edge-traefik. The hostname is NEVER hardcoded: it is
# `<subdomain>.<topology.external.public_fqdn>`, and public_fqdn comes from the ciu.env
# PUBLIC_FQDN fact. TLS/cert are inherited from traefik's `websecure` entrypoint.
enabled = true
subdomain = "naf"

[app_local.hooks]
pre_compose = []
# D-007: seeds config["topology"]["dns"]["delegated_zone"] into the app's own
# database as a manageable ManagedDomainRoot/BackendService once the app
# container is healthy — the app-side analog of
# tooling/backend-powerdns/post_compose_zone.py (which makes PowerDNS
# authoritative for the same zone). No-op when the zone is empty. See
# post_compose_seed_domain.py for the full contract.
# 1. post_compose_init_instance.py — readiness, then the idempotent create-or-UPDATE init of THIS
#    instance (bootstrap admin from the ciu secret, Mailpit email config) via `docker exec` of
#    `python -m netcup_api_filter.bootstrap init --enforce-admin`. Never writes into the container.
# 2. post_compose_seed_domain.py — D-007 delegated zone (below).
post_compose = ["post_compose_init_instance.py", "post_compose_seed_domain.py"]
