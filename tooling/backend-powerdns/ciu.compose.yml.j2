# tooling/backend-powerdns/ciu.compose.yml.j2 — self-hosted authoritative DNS
# =============================================================================
#   Rendered output: ciu.compose.yml  (GITIGNORED)
#   Governance overlay: .ciu/ciu.compose.overlay.yml (generated by ciu from
#   [governance] in ciu.global.toml — cgroup_parent / mem_limit / blkio IOPS)
#
# Two services, carried over unchanged from the pre-ciu docker-compose.yml:
#   * {{ backend_powerdns.name }}-init — one-shot using the SAME pinned PowerDNS
#     image: prepares the sqlite data dir (UID 953:DOCKER_GID), loads
#     schema.sqlite3.sql if the DB is missing. The upstream runtime image already
#     carries sqlite3, so there is no separate floating Alpine image to maintain.
#     Runs once, `depends_on: condition: service_completed_successfully` gates the
#     auth server on it finishing cleanly.
#   * {{ backend_powerdns.name }} — the PowerDNS Authoritative Server itself
#     (gsqlite3 backend), reading the volume the init container prepared.
#
# TWO DIFFERENT EXPOSURE SHAPES on the same container — do not conflate them:
#   * DNS (port 53, udp+tcp) is PUBLISHED TO THE HOST directly (`ports:`).
#     The delegation sends real resolver queries to this host's public IP on
#     port 53 — that traffic can NEVER go through traefik (it isn't HTTP).
#   * The HTTP API (port {{ backend_powerdns.ports.api }}) is NOT published to
#     the host at all. The app reaches PowerDNS internally over
#     {{ deploy.network_name }} (peer-to-peer, by container name). External
#     access to the API (operators, curl from outside) goes through traefik
#     at Host(`{{ topology.dns.pdns_subdomain }}.{{ topology.external.public_fqdn }}`)
#     on {{ topology.external.ingress_network }}, behind the same basicauth
#     guard as app-local — see the traefik label block below.
#
# NO PDNS_DEFAULT_SOA_NAME / PDNS_DEFAULT_SOA_MAIL env vars here (unlike the
# pre-ciu file). Those two had no committed default anywhere in this repo —
# keeping them would mean baking a single, zone-independent, effectively
# invented SOA into the container's static config, exactly what got the prior
# ciu-powerdns conversion attempt rejected. The SOA is zone-specific, so it is
# set per-zone by the post_compose hook (post_compose_zone.py) at zone-creation
# time, derived from {{ topology.dns.delegated_zone }} — never hardcoded.
# =============================================================================

services:
  {{ backend_powerdns.name }}-init:
    image: {{ backend_powerdns.image }}:{{ backend_powerdns.image_tag }}
    # This versioned release tag is pulled when it is not already available.
    pull_policy: missing
    # The official image runs as pdns by default and has a startup.py entrypoint.
    # This one-shot needs root only to prepare/chown the bind mount, and it needs a
    # plain shell rather than the PowerDNS daemon entrypoint.
    user: "0:0"
    entrypoint: ["/bin/sh", "-c"]
    container_name: {{ deploy.project_name }}-{{ deploy.environment_tag }}-{{ backend_powerdns.name }}-init

    volumes:
      - ${PHYSICAL_REPO_ROOT:?PHYSICAL_REPO_ROOT must be set}/tooling/backend-powerdns/data:/data
      - ${PHYSICAL_REPO_ROOT:?PHYSICAL_REPO_ROOT must be set}/tooling/backend-powerdns/schema.sqlite3.sql:/schema.sqlite3.sql:ro

    command:
      - |
        echo '[init] Preparing data directory for PowerDNS (UID {{ backend_powerdns.uid }}), group docker (GID from host: ${DOCKER_GID})'

        # Ensure directory exists and is writable
        mkdir -p /data
        chmod 755 /data
        ls -l /data

        # Initialize database if missing
        if [ ! -f /data/pdns.sqlite3 ]; then
          echo '[init] Creating database from schema'
          sqlite3 /data/pdns.sqlite3 < /schema.sqlite3.sql
          echo '[init] Database created'
        else
          echo '[init] Database exists'
        fi

        # Set ownership to PowerDNS user (UID {{ backend_powerdns.uid }}), group `docker` (GID from host)
        chown -R {{ backend_powerdns.uid }}:${DOCKER_GID} /data
        chmod 770 /data
        chmod 660 /data/*.db /data/*.sqlite* 2>/dev/null || true

        ls -l /data

        echo '[init] Data directory ready'

    networks:
      - {{ deploy.network_name }}

    labels:
      - "{{ deploy.labels.prefix }}.component={{ backend_powerdns.name }}-init"
      - "{{ deploy.labels.prefix }}.stack=tooling"
      - "{{ deploy.labels.prefix }}.service-type=init"
      - "{{ deploy.labels.prefix }}.managed-by=ciu"

  {{ backend_powerdns.name }}:
    image: {{ backend_powerdns.image }}:{{ backend_powerdns.image_tag }}
    # This versioned release tag is pulled when it is not already available.
    pull_policy: missing
    container_name: {{ deploy.project_name }}-{{ deploy.environment_tag }}-{{ backend_powerdns.name }}
    hostname: {{ deploy.project_name }}-{{ deploy.environment_tag }}-{{ backend_powerdns.name }}

    # Wait for init container to complete
    depends_on:
      {{ backend_powerdns.name }}-init:
        condition: service_completed_successfully

    environment:
      # The image auto-generates API config only for PDNS_AUTH_API_KEY. This
      # stack uses its documented TEMPLATE_FILES mechanism so every daemon
      # option below is rendered once into the config directory from the
      # mounted config template.
      - POWERDNS_API_KEY=${POWERDNS_API_KEY:?POWERDNS_API_KEY must be set}
      - TEMPLATE_FILES={{ backend_powerdns.api.template_name }}
      - PDNS_AUTH_API={{ backend_powerdns.pdns.auth_api }}
      - PDNS_AUTH_WEBSERVER={{ backend_powerdns.pdns.webserver }}
      - PDNS_AUTH_WEBSERVER_ADDRESS={{ backend_powerdns.pdns.webserver_address }}
      - PDNS_AUTH_WEBSERVER_PORT={{ backend_powerdns.ports.api }}
      - PDNS_AUTH_WEBSERVER_ALLOW_FROM={{ backend_powerdns.pdns.webserver_allow_from }}

      # Database backend
      - PDNS_LAUNCH={{ backend_powerdns.pdns.launch }}
      - PDNS_GSQLITE3_DATABASE={{ backend_powerdns.pdns.gsqlite3_database }}
      - PDNS_GSQLITE3_DNSSEC={{ backend_powerdns.pdns.gsqlite3_dnssec }}

      # Logging
      - PDNS_LOGLEVEL={{ backend_powerdns.pdns.loglevel }}
      - PDNS_LOG_DNS_QUERIES={{ backend_powerdns.pdns.log_dns_queries }}
      - PDNS_LOG_DNS_DETAILS={{ backend_powerdns.pdns.log_dns_details }}

      # Security
      - PDNS_DISABLE_AXFR={{ backend_powerdns.pdns.disable_axfr }}

    secrets:
      - powerdns_api_key

    ports:
      # DNS server (public access required — see header. NOT a traefik route).
      - "{{ backend_powerdns.ports.dns }}:53/udp"
      - "{{ backend_powerdns.ports.dns }}:53/tcp"
      # API port ({{ backend_powerdns.ports.api }}) is intentionally NOT published
      # here — internal peers use the project network; external access is the
      # traefik route below.

    volumes:
      # Persistent database storage (prepared by init container)
      - ${PHYSICAL_REPO_ROOT:?PHYSICAL_REPO_ROOT must be set}/tooling/backend-powerdns/data:/var/lib/powerdns
      # PowerDNS startup renders this template into pdns.d using the
      # environment above (including the checkout-local API key). The image's
      # startup.py opens templates.d/<TEMPLATE_FILES entry>.j2 and writes
      # pdns.d/<entry>.conf, so the mount target must be <entry>.j2 (no .conf).
      - ${PHYSICAL_REPO_ROOT:?PHYSICAL_REPO_ROOT must be set}/tooling/backend-powerdns/pdns-auth.conf.j2:/etc/powerdns/templates.d/{{ backend_powerdns.api.template_name }}.j2:ro

    # Run as pdns user (UID {{ backend_powerdns.uid }}) with docker group (GID from host)
    # This allows PowerDNS to access the database owned by {{ backend_powerdns.uid }}:docker
    user: "{{ backend_powerdns.uid }}:${DOCKER_GID}"

    networks:
      - {{ deploy.network_name }}
      - {{ topology.external.ingress_network }}

    restart: unless-stopped

    # Required for binding to privileged port 53
    cap_add:
      - NET_BIND_SERVICE

    healthcheck:
      test: ["CMD", "pdns_control", "version"]
      interval: {{ backend_powerdns.health.interval }}
      timeout: {{ backend_powerdns.health.timeout }}
      retries: {{ backend_powerdns.health.retries }}
      start_period: {{ backend_powerdns.health.start_period }}

    labels:
      - "{{ deploy.labels.prefix }}.component={{ backend_powerdns.name }}"
      - "{{ deploy.labels.prefix }}.stack=tooling"
      - "{{ deploy.labels.prefix }}.service-type=dns"
      - "{{ deploy.labels.prefix }}.managed-by=ciu"
    {%- if backend_powerdns.external.enabled %}
      # --- traefik ingress (host edge-traefik) for the HTTP API only. TLS/cert
      # inherited from the entrypoint — see app-local's header for why no
      # tls/certresolver labels are needed here. Because this container is
      # multi-homed (project network + ingress network), traefik.docker.network
      # is set explicitly, else traefik may pick the wrong address to route to.
      - "traefik.enable=true"
      - "traefik.docker.network={{ topology.external.ingress_network }}"
      - "traefik.http.routers.{{ deploy.project_name }}-{{ deploy.environment_tag }}-{{ backend_powerdns.name }}.rule=Host(`{{ topology.dns.pdns_subdomain }}.{{ topology.external.public_fqdn }}`)"
      - "traefik.http.routers.{{ deploy.project_name }}-{{ deploy.environment_tag }}-{{ backend_powerdns.name }}.entrypoints=websecure"
      - "traefik.http.services.{{ deploy.project_name }}-{{ deploy.environment_tag }}-{{ backend_powerdns.name }}.loadbalancer.server.port={{ backend_powerdns.ports.api }}"
    {%- if topology.guard.enabled %}
      # basicauth: same guard middleware app-local uses (D-007: "behind the
      # same basicauth guard as the app"). The hash comes from the ENVIRONMENT
      # at compose-up time, not from ciu config — see app-local's header for
      # why (bcrypt hashes begin "$2b$", which ciu's placeholder pass would
      # reject as an unresolved "$2b" placeholder).
      - "traefik.http.routers.{{ deploy.project_name }}-{{ deploy.environment_tag }}-{{ backend_powerdns.name }}.middlewares={{ deploy.project_name }}-{{ deploy.environment_tag }}-guard"
      - "traefik.http.middlewares.{{ deploy.project_name }}-{{ deploy.environment_tag }}-guard.basicauth.users={{ topology.guard.user }}:${NAF_GUARD_HTPASSWD:?NAF_GUARD_HTPASSWD not set — source .env.guard}"
    {%- endif %}
    {%- endif %}

networks:
  {{ deploy.network_name }}:
    external: true
    name: {{ deploy.network_name }}
  {{ topology.external.ingress_network }}:
    external: true
    name: {{ topology.external.ingress_network }}
