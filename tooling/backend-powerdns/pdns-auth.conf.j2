# Rendered by the PowerDNS image startup wrapper into /etc/powerdns/pdns.d.
# The wrapper only auto-generates API config for PDNS_AUTH_API_KEY; this stack
# deliberately supplies the full config through TEMPLATE_FILES instead.
api={{ PDNS_AUTH_API }}
api-key={{ POWERDNS_API_KEY }}
webserver={{ PDNS_AUTH_WEBSERVER }}
webserver-address={{ PDNS_AUTH_WEBSERVER_ADDRESS }}
webserver-port={{ PDNS_AUTH_WEBSERVER_PORT }}
webserver-allow-from={{ PDNS_AUTH_WEBSERVER_ALLOW_FROM }}
webserver-password={{ POWERDNS_API_KEY }}

launch={{ PDNS_LAUNCH }}
gsqlite3-database={{ PDNS_GSQLITE3_DATABASE }}
gsqlite3-dnssec={{ PDNS_GSQLITE3_DNSSEC }}

loglevel={{ PDNS_LOGLEVEL }}
log-dns-queries={{ PDNS_LOG_DNS_QUERIES }}
log-dns-details={{ PDNS_LOG_DNS_DETAILS }}

disable-axfr={{ PDNS_DISABLE_AXFR }}
