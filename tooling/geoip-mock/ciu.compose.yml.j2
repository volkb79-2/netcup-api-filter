# tooling/geoip-mock/ciu.compose.yml.j2 — PERSISTENT PEER form (ciu-managed)
# =============================================================================
#   Rendered output: ciu.compose.yml  (GITIGNORED)
#   Governance overlay: .ciu/ciu.compose.overlay.yml (generated by ciu from
#   [governance] in ciu.global.toml — cgroup_parent / mem_limit / blkio IOPS)
#
# Mock implementation of the MaxMind GeoIP API, used by ui_tests and by the
# app under test via MOCK_GEOIP_API_URL (see .env.services). Stays up on the
# naf network as a peer, alongside naf-mailpit and naf-mock-netcup-api.
#
# WART, CARRIED OVER UNCHANGED (not introduced here): this uses the stock
# python:3.11-slim image and `pip install`s flask at container START rather
# than baking a custom image — same as the pre-ciu docker-compose.yml. Fixing
# that (a real Dockerfile/build) is out of scope for this conversion.
# =============================================================================

services:
  {{ geoip_mock.name }}:
    image: {{ geoip_mock.image }}:{{ geoip_mock.image_tag }}
    # Always re-pull so a moving tag (:latest / :3.11-slim) never gets stuck stale.
    pull_policy: missing
    container_name: {{ deploy.project_name }}-{{ deploy.environment_tag }}-{{ geoip_mock.name }}
    restart: unless-stopped
    working_dir: /app
    # See header — pip install at start, not a baked image.
    command: >
      sh -c "pip install --no-cache-dir flask &&
             python -m flask run --host=0.0.0.0 --port={{ geoip_mock.port }}"
    # No host ports: peers reach this service by container name on the project network.
    expose:
      - "{{ geoip_mock.port }}"
    volumes:
      # HOST path (DooD) — see [geoip_mock.mounts].workspace. Mounts ui_tests/
      # (contains mock_geoip_server.py), read-only.
      - ${PHYSICAL_REPO_ROOT:-{{ geoip_mock.mounts.workspace }}}/ui_tests:/app:ro
    environment:
      - FLASK_APP=mock_geoip_server:app
      - FLASK_RUN_PORT={{ geoip_mock.port }}
      - FLASK_RUN_HOST=0.0.0.0
      - FLASK_ENV=${FLASK_ENV:-development}
      - FLASK_DEBUG=${FLASK_DEBUG:-false}
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:{{ geoip_mock.port }}/health')"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    networks:
      - {{ deploy.network_name }}
    labels:
      - "{{ deploy.labels.prefix }}.component={{ geoip_mock.name }}"
      - "{{ deploy.labels.prefix }}.stack=tooling"
      - "{{ deploy.labels.prefix }}.service-type=mock"
      - "{{ deploy.labels.prefix }}.managed-by=ciu"

networks:
  {{ deploy.network_name }}:
    external: true
    name: {{ deploy.network_name }}
