# tooling/mailpit/ciu.compose.yml.j2 — PERSISTENT PEER form (ciu-managed)
# =============================================================================
#   Rendered output: ciu.compose.yml  (GITIGNORED)
#   Governance overlay: .ciu/ciu.compose.overlay.yml (generated by ciu from
#   [governance] in ciu.global.toml — cgroup_parent / mem_limit / blkio IOPS)
#
# Mailpit captures outbound SMTP from the app and the test suite (password reset,
# 2FA, invite emails) and exposes a web UI + REST API to inspect/assert against
# captured messages. ui_tests/mailpit_client.py, the e2e lane and
# build_deployment.py all reach this checkout's resolved container identity, so
# the explicit instance-derived container_name is load-bearing SMTP/API routing.
#
# INTERNAL-ONLY: no traefik.* labels. Mailpit is never exposed outside the naf
# network; exposure is a centrally-decided concern (see the marker header).
# =============================================================================

services:
  {{ mailpit.name }}:
    image: {{ mailpit.image }}:{{ mailpit.image_tag }}
    # Always re-pull so a moving tag (:latest / :3.11-slim) never gets stuck stale.
    pull_policy: missing
    container_name: {{ deploy.project_name }}-{{ deploy.environment_tag }}-{{ mailpit.name }}
    restart: unless-stopped
    # No host ports: peers reach this service by container name on the project network.
    expose:
      - "{{ mailpit.web_port }}"
      - "{{ mailpit.smtp_port }}"
    environment:
      # No UI/API auth: this service is internal-only (no traefik labels, no host
      # ports), reachable solely by peers on the project network.

      # Accept any SMTP auth (for testing) - allow without TLS
      MP_SMTP_AUTH_ALLOW_INSECURE: "true"
      # Disable SMTP auth entirely for simple testing
      MP_SMTP_AUTH_ACCEPT_ANY: "true"

      # Max message size
      MP_MAX_MESSAGE_SIZE: "${MAILPIT_MAX_MESSAGE_SIZE:?MAILPIT_MAX_MESSAGE_SIZE must be set}"

      # UI features
      MP_UI_BIND_ADDR: "0.0.0.0:{{ mailpit.web_port }}"
      MP_SMTP_BIND_ADDR: "0.0.0.0:{{ mailpit.smtp_port }}"

      # Verbose logging for debugging
      MP_VERBOSE: "${MAILPIT_VERBOSE:-false}"

      # Webroot for reverse proxy (must match nginx location)
      MP_WEBROOT: "${MAILPIT_WEBROOT:-}"
    healthcheck:
      # Exit code 0 only if the web UI answers HTTP 200.
      test: ["CMD", "sh", "-c", "wget -q -O /dev/null -S http://localhost:{{ mailpit.web_port }}/mailpit/ 2>&1 | grep -qE 'HTTP/1.1 200'"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
    networks:
      - {{ deploy.network_name }}
    labels:
      - "{{ deploy.labels.prefix }}.component={{ mailpit.name }}"
      - "{{ deploy.labels.prefix }}.stack=tooling"
      - "{{ deploy.labels.prefix }}.service-type=mock"
      - "{{ deploy.labels.prefix }}.managed-by=ciu"

networks:
  {{ deploy.network_name }}:
    external: true
    name: {{ deploy.network_name }}
