# =============================================================================
#   Rendered output: ciu.compose.yml  (GITIGNORED)
#   Governance overlay: .ciu/ciu.compose.overlay.yml (generated by ciu from
#   [governance] in ciu.global.toml — cgroup_parent / mem_limit / blkio IOPS)
#
# Netcup CCP API mock — stays up as a peer on the naf network so the gate
# suite (mocks/roundtrip/e2e) can reach it. Tests point `api_url` at the
# resolved instance-derived container name and port (see conftest_mock_api.py).
#
# WART (not fixed here, carried unchanged from the old docker-compose.yml):
# the container `pip install`s flask at start instead of a purpose-built
# image with the dependency baked in.
# =============================================================================

services:
  {{ netcup_api_mock.name }}:
    image: {{ netcup_api_mock.image }}:{{ netcup_api_mock.tag }}
    # Always re-pull so a moving tag (:latest / :3.11-slim) never gets stuck stale.
    pull_policy: missing
    container_name: {{ deploy.project_name }}-{{ deploy.environment_tag }}-{{ netcup_api_mock.name }}
    restart: unless-stopped
    working_dir: /app
    command: >
      sh -c "pip install --no-cache-dir flask &&
             python -m flask run --host=0.0.0.0 --port={{ netcup_api_mock.port }}"
    # No host ports: peers reach this service by container name on the project network.
    expose:
      - "{{ netcup_api_mock.port }}"
    volumes:
      # Mount ui_tests directory (contains mock_netcup_api.py).
      # HOST path (DooD): the docker socket is the host's, so -v sources are host paths.
      - ${PHYSICAL_REPO_ROOT:?PHYSICAL_REPO_ROOT must be set}/ui_tests:/app:ro
    environment:
      {% for key, value in deploy.env.defaults.items() %}
      - {{ key }}={{ value }}
      {% endfor %}
      - FLASK_APP=mock_netcup_api:app
      - FLASK_RUN_PORT={{ netcup_api_mock.port }}
      - FLASK_RUN_HOST=0.0.0.0
      - FLASK_ENV=${FLASK_ENV:-development}
      - FLASK_DEBUG=${FLASK_DEBUG:-false}
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:{{ netcup_api_mock.port }}/health')"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    networks:
      - {{ deploy.network_name }}
    labels:
      - "{{ deploy.labels.prefix }}.component={{ netcup_api_mock.name }}"
      - "{{ deploy.labels.prefix }}.stack=tooling"
      - "{{ deploy.labels.prefix }}.service-type=mock"
      - "{{ deploy.labels.prefix }}.managed-by=ciu"

networks:
  {{ deploy.network_name }}:
    external: true
    name: {{ deploy.network_name }}
