# tooling/test-runner/ciu.compose.yml.j2 — PERSISTENT PEER form (ciu-managed)
# =============================================================================
#   Rendered output: ciu.compose.yml  (GITIGNORED)
#   Governance overlay: .ciu/ciu.compose.overlay.yml (generated by ciu from
#   [governance] in ciu.global.toml — cgroup_parent / mem_limit / blkio IOPS)
#
# Two ways to run the gate:
#   * EPHEMERAL (`testing-exec.sh unit`) — `docker run --rm`, no prior `up` state.
#     This is the GATING form. Prefer it. It does not read this file.
#   * PERSISTENT PEER (this file) — stays up on the naf network so the suite can
#     reach the mock services (naf-mailpit, naf-mock-geoip, naf-mock-netcup-api),
#     the pwmcp browser container, and a deployed app as a peer.
#
# The image is python 3.11 (the primary Passenger target), NOT the devcontainer's
# 3.14 — see the Dockerfile header. Never run the gating suite in the devcontainer.
#
# App DATA lives in the app/service containers — never mount service data dirs
# here; reach data through the service protocol (HTTP/SMTP).
# =============================================================================

services:
  {{ test_runner.name }}:
    image: {% if deploy.registry.url %}{{ deploy.registry.url }}/{% endif %}{{ deploy.registry.namespace }}/{{ test_runner.image_name }}:{{ test_runner.image_tag }}
    build:
      context: ../..
      dockerfile: tooling/test-runner/Dockerfile
      args:
        PYTHON_VERSION: "{{ test_runner.python_version }}"
    container_name: {{ deploy.project_name }}-{{ deploy.environment_tag }}-{{ test_runner.name }}
    hostname: {{ test_runner.name }}
    restart: unless-stopped
    # Run as the host-owned uid so bind-mounted files stay writable. The image
    # gives this uid a real passwd entry + HOME + XDG dirs (see Dockerfile) — a
    # gate without a full identity fails in ways that look like breakage but are
    # pure environment.
    user: "${CONTAINER_UID:-${USER_UID}}:${DOCKER_GID}"
    environment:
      {% for key, value in deploy.env.defaults.items() %}
      - {{ key }}={{ value }}
      {% endfor %}
      # Browser is ALWAYS external (pwmcp); no engine is installed in this image.
      - PLAYWRIGHT_SERVER_WS={{ test_runner.pwmcp.ws_url }}
      - PWMCP_REQUIRED={{ 1 if test_runner.pwmcp.required else 0 }}
      - PWMCP_SESSION_LABEL={{ test_runner.pwmcp.session_label }}
    volumes:
      # HOST path (DooD) — see [test_runner.mounts].workspace.
      - ${PHYSICAL_REPO_ROOT:?required host path — source ciu.env}:{{ ciu.repo_root }}:rw
      - /var/run/docker.sock:/var/run/docker.sock:rw
    working_dir: {{ ciu.repo_root }}
    networks:
      - {{ deploy.network_name }}
    stdin_open: true
    tty: true
    labels:
      - "{{ deploy.labels.prefix }}.component={{ test_runner.name }}"
      - "{{ deploy.labels.prefix }}.stack=tooling"
      - "{{ deploy.labels.prefix }}.service-type=test"
      - "{{ deploy.labels.prefix }}.managed-by=ciu"

networks:
  {{ deploy.network_name }}:
    external: true
    name: {{ deploy.network_name }}
