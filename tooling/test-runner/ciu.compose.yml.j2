# tooling/test-runner/ciu.compose.yml.j2 — PERSISTENT runners, one per Python version
# =============================================================================
#   Rendered output: ciu.compose.yml  (GITIGNORED)
#   Governance overlay: .ciu/ciu.compose.overlay.yml (generated by ciu from
#   [governance] in ciu.global.toml — cgroup_parent / mem_limit / blkio IOPS)
#
# run-gate dispatches lanes into these with `docker exec` (run-gate.toml,
# mode = "exec"); ciu owns build and lifecycle. Each variant is the shipped
# interpreter (3.11 Passenger, 3.14 OCI), never the devcontainer's. The runners
# sit on the instance network so suites reach the mocks (their container names
# come from `ciu resolve --json`, via .env.services), pwmcp and a deployed app
# as peers. Every checkout (main or linked worktree) runs its OWN pair:
# `ciu up --dir tooling/test-runner` in that checkout precedes any gate there.
#
# App DATA lives in the app/service containers — reach it through the service
# protocol (HTTP/SMTP), never a mount.
# =============================================================================

services:
{% for v in test_runner.variants %}
  {{ v.name | replace("py", "test-runner-py") }}:
    image: {% if deploy.registry.url %}{{ deploy.registry.url }}/{% endif %}{{ deploy.registry.namespace }}/{{ test_runner.image_name }}:{{ v.name }}
    build:
      context: {{ ciu.repo_root }}
      dockerfile: tooling/test-runner/Dockerfile
      args:
        PYTHON_VERSION: "{{ v.python_version }}"
        PYTHON_BASE_IMAGE: "{{ v.python_base_image }}"
        RUN_UID: "${CONTAINER_UID:?required — source ciu.env}"
        RUN_GID: "${DOCKER_GID:?required — source ciu.env}"
    container_name: {{ deploy.project_name }}-{{ deploy.environment_tag }}-test-runner-{{ v.name }}
    hostname: test-runner-{{ v.name }}
    restart: unless-stopped
    user: "${CONTAINER_UID:?required — source ciu.env}:${DOCKER_GID:?required — source ciu.env}"
    environment:
      {% for key, value in deploy.env.defaults.items() %}
      - {{ key }}={{ value }}
      {% endfor %}
      - PLAYWRIGHT_SERVER_WS={{ test_runner.pwmcp.ws_url }}
      - PWMCP_REQUIRED={{ 1 if test_runner.pwmcp.required else 0 }}
      - PWMCP_SESSION_LABEL={{ test_runner.pwmcp.session_label }}
      - PWMCP_LEASE_SECONDS={{ test_runner.pwmcp.lease_seconds }}
      # The per-session e2e app (ui_tests/e2e_env.py) is reached by the pwmcp browser at
      # http://<this container's name>:<port> — the container name is unique on the shared network.
      - NAF_E2E_ADVERTISE_HOST={{ deploy.project_name }}-{{ deploy.environment_tag }}-test-runner-{{ v.name }}
    volumes:
      - ${PHYSICAL_REPO_ROOT:?required host path — source ciu.env}:{{ ciu.repo_root }}:rw
      - /var/run/docker.sock:/var/run/docker.sock:rw
      - type: volume
        source: run-gate-state-{{ v.name }}
        target: {{ test_runner.run_gate.state_root }}
{% if '/.worktrees/' in ciu.repo_root|string %}
      # LINKED-WORKTREE INSTANCE ONLY (renders only when repo_root names a
      # `.worktrees/<name>` checkout): the git COMMON directory, read-write.
      #
      # Every checkout runs its own runners (environment_tag = $INSTANCE_ID), and
      # a worktree's runner mounts only the worktree subtree above. The worktree's
      # `.git` is a pointer file naming `<main checkout>/.git/worktrees/<name>`, a
      # path that mount does not carry. Without this block every git call in the
      # runner exits 128: assay lanes abort with ERROR/GIT_FAILED before any lane
      # work, and the tracked-file hygiene tests silently fall back to a
      # filesystem walk (tests/test_powerdns_config_hygiene.py).
      #
      # Both halves are DERIVED, never configured: the host path is
      # PHYSICAL_REPO_ROOT two levels up (naf's layout is `.worktrees/<name>`),
      # the container path is ciu.repo_root cut at `/.worktrees/`, which is
      # exactly what the pointer file names.
      #
      # rw on purpose: assay lanes with [lanes.*.isolation] snapshot_selection =
      # "repository" (assay.toml) build their snapshot with `git worktree add`,
      # which creates `<common dir>/worktrees/<snap>`; `:ro` turns that into a
      # bare GIT_FAILED. Parity, not a new privilege: the main checkout's runner
      # mounts the whole checkout, `.git` included, read-write. A lane that
      # abandons a snapshot leaves an entry `git worktree prune` clears.
      # Reference consumer: dstdns tools/test-runner/ciu.compose.yml.j2.
      - ${PHYSICAL_REPO_ROOT:?required host path — source ciu.env}/../../.git:{{ (ciu.repo_root|string).split('/.worktrees/')[0] }}/.git:rw
{% endif %}
    # The suite opens many SQLite files and sockets in one process; Docker's per-process default of 1024 is
    # too low for it. A need, not a host limit.
    ulimits:
      nofile:
        soft: 65536
        hard: 65536
    working_dir: {{ ciu.repo_root }}
    networks:
      - {{ deploy.network_name }}
      - {{ topology.pwmcp.network }}   # ws://pwmcp:3000 (the provided instance)
    stdin_open: true
    tty: true
    labels:
      - "{{ deploy.labels.prefix }}.component=test-runner-{{ v.name }}"
      - "{{ deploy.labels.prefix }}.stack=tooling"
      - "{{ deploy.labels.prefix }}.service-type=test"
      - "{{ deploy.labels.prefix }}.managed-by=ciu"
{% endfor %}

networks:
  {{ deploy.network_name }}:
    external: true
    name: {{ deploy.network_name }}
  {{ topology.pwmcp.network }}:
    external: true
    name: {{ topology.pwmcp.network }}

volumes:
{% for v in test_runner.variants %}
  run-gate-state-{{ v.name }}: {}
{% endfor %}
