# tooling/test-runner/ciu.defaults.toml.j2 — STACK MARKER (gating test-runner)
# =============================================================================
#   Rendered output: ciu.toml  (GITIGNORED — never edit or commit the rendered file)
#
# This replaces the previously COMMITTED `ciu.toml`, which was a rendered-output
# filename checked in as if it were source, with a hardcoded host path and no
# generator behind it. The workspace mount now derives from the ciu.env machine
# fact instead of being hand-synced with .env.workspace.
#
# NOTE: adoption is ADDITIVE. The gating entrypoint
# `./tooling/test-runner/testing-exec.sh unit` still uses the EPHEMERAL
# `docker run --rm` path (no `ciu up` state to leak between attempts) and is
# unaffected by this file. ciu governs the PERSISTENT PEER form.
# =============================================================================

[test_runner]
name = "test-runner"
image_name = "test-runner"
image_tag = "local"

# The FIDELITY knob and the reason this container exists: the image is built per
# Passenger target (3.11 primary / 3.9 secondary), never the devcontainer's 3.14.
python_version = "{{ build.python_version_primary }}"

[test_runner.mounts]
# HOST path (DooD: the docker socket is the host's, so -v sources are host paths).
workspace = "{{ ciu.physical_repo_root }}"

[test_runner.hooks]
pre_compose = []
post_compose = []

# The browser is ALWAYS external: no engine is installed in the gate image. The
# e2e gate drives the Playwright-as-a-Service container over PLAYWRIGHT_SERVER_WS.
# naf uses the raw `chromium.connect(ws://pwmcp:3000/)` path — it does NOT need
# the pwmcp lease/contract client. See infra/pwmcp/ (naf-I02).
[test_runner.pwmcp]
required = false
ws_url = "ws://pwmcp:3000/"
lease_seconds = 1800
session_label = "naf-test-runner"
