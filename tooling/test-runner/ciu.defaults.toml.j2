# tooling/test-runner/ciu.defaults.toml.j2 — STACK MARKER (gating test-runner)
# =============================================================================
#   Rendered output: ciu.toml  (GITIGNORED — never edit or commit the rendered file)
#
# This replaces the previously COMMITTED `ciu.toml`, which was a rendered-output
# filename checked in as if it were source, with a hardcoded host path and no
# generator behind it. The workspace mount now derives from the ciu.env machine
# fact instead of being hand-synced with .env.workspace.
#
# =============================================================================

[test_runner]
image_name = "test-runner"
image_tag = "local"

# One persistent runner per shipped Python version (the fidelity knob: never the
# devcontainer's interpreter). The service/container name is test-runner-<name>;
# run-gate.toml declares one exec environment per name.
[[test_runner.variants]]
name = "py311"
python_version = "{{ build.python_version_primary }}"
python_base_image = "{{ build.python_base_image }}"

[[test_runner.variants]]
name = "py314"
python_version = "{{ build.python_version_secondary }}"
python_base_image = "{{ build.python_base_image_secondary }}"

[test_runner.run_gate]
# MUST equal run-gate.toml [environments.*].state_root (outside every checkout).
state_root = "/run-gate-state"

[test_runner.mounts]
# HOST path (DooD: the docker socket is the host's, so -v sources are host paths).
workspace = "{{ ciu.physical_repo_root }}"

[test_runner.hooks]
pre_compose = []
post_compose = []

# The browser is ALWAYS external: no engine is installed in the gate image. The
# e2e gate drives the Playwright-as-a-Service container over PLAYWRIGHT_SERVER_WS.
# naf speaks the gateway protocol itself (ui_tests/pwmcp_connection.py), without the
# pwmcp-client wheel: it reads GET /contract once per session (Playwright major.minor and
# max_lease_seconds), then makes ONE chromium.connect(ws://pwmcp:3000/) per pytest session
# with the lease headers below. The pwmcp instance is provided by the estate
# (/srv/pwmcp-instance); see [topology.pwmcp].
# lease_seconds covers the whole e2e lane budget (run-gate.toml [lanes.e2e] budget = 120m)
# and equals the gateway's max_lease_seconds (7200; a larger value is capped by /contract).
# The lease ends when the websocket closes, so a finished or killed lane frees its slot at
# once; the long lease only matters for a lane that is still running. If a lease still runs
# short, the harness renews it between tests (E2E_PWMCP_LEASE_RENEW_MARGIN_SECONDS).
[test_runner.pwmcp]
required = false
ws_url = "ws://pwmcp:3000/"
lease_seconds = 7200
session_label = "naf-test-runner"
