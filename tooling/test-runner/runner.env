# Identity of the gating test-runner (version-controlled — NOT per-environment).
#
# Per-environment values (PHYSICAL_REPO_ROOT, DOCKER_NETWORK_INTERNAL) are NOT here:
# they live in the auto-generated .env.workspace. Secrets are never here.
#
# PYTHON_VERSION is the FIDELITY knob and the reason this container exists:
#   3.11 = the primary Passenger deploy target (deploy.sh -> deploy-py311.zip).
#   3.9  = the secondary target; rebuild with PYTHON_VERSION=3.9 to exercise the
#          3.9 compat guards (see deploy.sh PYTHON_TARGETS).
# The devcontainer's 3.14 is NOT a valid gate interpreter — that is the whole point.

export TEST_RUNNER_IMAGE="netcup-api-filter/test-runner:local"
export TEST_RUNNER_CONTAINER="naf-dev-test-runner"
export PYTHON_VERSION="${PYTHON_VERSION:-3.11}"
